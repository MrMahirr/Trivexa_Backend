# =============================================
# Trivexa Backend — Production Environment
# =============================================

# App
NODE_ENV=production
APP_PORT=3500
API_PREFIX=api/v1

# Database (PostgreSQL)
DB_HOST=prod-db.trivexa.internal
DB_PORT=5432
DB_NAME=trivexa_production
DB_USER=trivexa_prod_user
DB_PASSWORD=CHANGE_ME_STRONG_PRODUCTION_PASSWORD

# Redis
REDIS_HOST=prod-redis.trivexa.internal
REDIS_PORT=6379

# JWT Secrets (Production — güçlü, 64+ karakter!)
JWT_ACCESS_SECRET=CHANGE_ME_PRODUCTION_ACCESS_SECRET_MIN_64_CHARS
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=CHANGE_ME_PRODUCTION_REFRESH_SECRET_MIN_64_CHARS
JWT_REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGIN=https://app.trivexa.com

# Security
BCRYPT_SALT_ROUNDS=12

# Mail (Production — gerçek SMTP)
MAIL_HOST=smtp.your-email-provider.com
MAIL_PORT=587
MAIL_USER=CHANGE_ME
MAIL_PASS=CHANGE_ME
MAIL_FROM=noreply@trivexa.com
