%% Veritabanı ER (Entity-Relationship) Diyagramı
%% Bu diyagram, Trivexa sistemindeki tüm veritabanı tablolarını
%% ve aralarındaki ilişkileri gösterir.
%% Tablolar: Kullanıcılar, İzinler, Müşteriler, Projeler, Görevler,
%% Faturalar, Ödemeler ve Zaman Kayıtları.

erDiagram

    users {
        uuid user_id
        varchar full_name
        varchar email
        varchar role
        varchar department
    }

    user_permissions {
        uuid permission_id
        uuid user_id
        varchar permission
    }

    clients {
        uuid client_id
        varchar company_name
        uuid created_by
    }

    client_users {
        uuid client_user_id
        uuid client_id
        varchar full_name
    }

    projects {
        uuid project_id
        uuid client_id
        varchar name
        varchar project_code
        uuid created_by
    }

    project_members {
        uuid member_id
        uuid project_id
        uuid user_id
        varchar role
    }

    department_tasks {
        uuid task_id
        uuid project_id
        uuid assigned_to
        uuid parent_task_id
        varchar title
        varchar status
    }

    invoices {
        uuid invoice_id
        uuid client_id
        uuid project_id
        varchar invoice_number
        decimal total_amount
    }

    invoice_items {
        uuid item_id
        uuid invoice_id
        uuid task_id
        decimal amount
    }

    payments {
        uuid payment_id
        uuid invoice_id
        uuid client_id
        decimal amount
    }

    time_entries {
        uuid entry_id
        uuid user_id
        uuid project_id
        uuid task_id
        int duration
    }

    %% Kullanıcı İlişkileri
    users ||--o{ user_permissions : "izinlere sahiptir"
    users ||--o{ project_members : "projelerde çalışır"
    users ||--o{ department_tasks : "görevlere atanır"

    %% Müşteri İlişkileri
    clients ||--o{ client_users : "kullanıcılara sahiptir"
    clients ||--o{ projects : "projelere sahiptir"
    clients ||--o{ invoices : "faturalandırılır"
    clients ||--o{ payments : "ödeme yapar"

    %% Proje İlişkileri
    projects ||--o{ project_members : "üyeleri içerir"
    projects ||--o{ department_tasks : "görevleri barındırır"
    projects ||--o{ invoices : "fatura üretir"
    projects ||--o{ time_entries : "zaman takibi yapılır"

    %% Fatura İlişkileri
    invoices ||--o{ invoice_items : "kalemleri içerir"
    invoices ||--o{ payments : "ödemeleri alır"

    %% Görev İlişkileri
    department_tasks ||--o{ invoice_items : "faturaya yansır"
    department_tasks ||--o{ time_entries : "zaman kaydı tutulur"
