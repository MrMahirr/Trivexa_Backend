flowchart TD
    %% Global Styles
    classDef person fill:#0d47a1,stroke:#002171,stroke-width:2px,color:#ffffff
    classDef system fill:#1b5e20,stroke:#003300,stroke-width:2px,color:#ffffff
    classDef container fill:#0277bd,stroke:#004c8c,stroke-width:2px,color:#ffffff
    classDef db fill:#f9a825,stroke:#c17900,stroke-width:2px,color:#ffffff
    classDef external fill:#7b1fa2,stroke:#4a0072,stroke-width:2px,color:#ffffff

    %% Actors
    Staff["👤 Agency Staff<br/>(Admin, Manager, Member)"]:::person
    Client["👤 Agency Client<br/>(Portal User)"]:::person

    %% Top Level Systems
    subgraph TrivexaSystem ["🏢 Trivexa Agency Management System"]
        WebApp["💻 Web Application<br/>(React Admin Panel)"]:::container
        Portal["📱 Client Portal<br/>(React Customer View)"]:::container
        
        subgraph Backend ["⚙️ Backend API (Modular Monolith)"]
            AuthMod["🔑 Auth Module"]:::system
            UserMod["👥 Users Module"]:::system
            ClientMod["🏢 Client Module"]:::system
            ProjectMod["📁 Project Module"]:::system
            TaskMod["✅ Task Module"]:::system
            FinanceMod["💰 Finance Module"]:::system
            NotifyMod["🔔 Notification Module"]:::system
        end
    end

    %% Infrastructure
    subgraph Infra ["🏗️ Infrastructure Services"]
        DB[("🐘 PostgreSQL<br/>(Primary Data)")]:::db
        Redis[("⚡ Redis<br/>(Cache & Queue)")]:::db
        Blob[("📦 Object Storage<br/>(AWS S3)")]:::db
    end

    %% External Systems
    subgraph External ["🌍 External Integrations"]
        Stripe["💳 Stripe API"]:::external
        Email["📧 SMTP / SES"]:::external
        Slack["💬 Slack API"]:::external
    end

    %% Relationships
    Staff -->|Uses| WebApp
    Client -->|Uses| Portal
    
    WebApp -->|JSON/REST| Backend
    Portal -->|JSON/REST| Backend

    Backend -->|Read/Write| DB
    Backend -->|Cache/PubSub| Redis
    Backend -->|Store Files| Blob

    Backend -->|Process Payments| Stripe
    Backend -->|Send Emails| Email
    Backend -->|Send Alerts| Slack
    
    %% Internal Module Dependencies (Simplified)
    AuthMod -.-> UserMod
    ProjectMod -.-> ClientMod
    TaskMod -.-> ProjectMod
    FinanceMod -.-> ClientMod
    NotifyMod -.-> UserMod

    linkStyle default stroke:#333,stroke-width:1px,color:#333
