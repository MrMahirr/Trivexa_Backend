# ============================================
# Trivexa Backend — Environment Variables (Example)
# Copy this file to .env and fill in the values
# ============================================

# ---------- App ----------
NODE_ENV=development
APP_PORT=3500
APP_PREFIX=api/v1
APP_NAME=Trivexa Backend

# ---------- Database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=2678
DB_NAME=trivexa_db
DB_USER=
DB_PASSWORD=
DB_POOL_MIN=2
DB_POOL_MAX=10

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- JWT (auto-generated at first start via scripts/generate-secrets.ts) ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ---------- Security ----------
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ---------- CORS ----------
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:3500
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:3500

# ---------- Client Portal ----------
# Development: http://localhost:3001
# Production:  https://your-portal-domain.com
CLIENT_PORTAL_BASE_URL=http://localhost:3001

# ---------- Docker (used by docker-compose) ----------
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---------- EmailJS (Notification) ----------
EMAIL_SERVICE_ID=
EMAIL_TEMPLATE_ID=
EMAIL_CONTACT_TEMPLATE_ID=
EMAIL_CONTACT_AUTO_REPLY_TEMPLATE_ID=
EMAIL_CLIENT_APPROVAL_TEMPLATE_ID=
EMAIL_USER_ID=
EMAIL_ACCESS_TOKEN=
CONTACT_FORM_RECEIVER=
ADMIN_NOTIFICATION_EMAIL=admin@trivexa.com
