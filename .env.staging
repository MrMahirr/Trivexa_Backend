# =============================================
# Trivexa Backend — Staging Environment
# =============================================

# App
NODE_ENV=staging
APP_PORT=3500
API_PREFIX=api/v1

# Database (PostgreSQL)
DB_HOST=staging-db.trivexa.internal
DB_PORT=5432
DB_NAME=trivexa_staging
DB_USER=trivexa_staging_user
DB_PASSWORD=CHANGE_ME_STAGING_PASSWORD

# Redis
REDIS_HOST=staging-redis.trivexa.internal
REDIS_PORT=6379

# JWT Secrets (Staging — farklı değerler kullanın!)
JWT_ACCESS_SECRET=CHANGE_ME_STAGING_ACCESS_SECRET
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=CHANGE_ME_STAGING_REFRESH_SECRET
JWT_REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGIN=https://staging.trivexa.com,http://localhost:3000

# Security
BCRYPT_SALT_ROUNDS=10

# Mail (Staging — sandbox)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=CHANGE_ME
MAIL_PASS=CHANGE_ME
MAIL_FROM=noreply@staging.trivexa.com
